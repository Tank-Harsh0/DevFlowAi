# =============================================================================
# DevFlow AI — Environment Variables
#
# Copy this file to .env and fill in values as needed.
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# NEVER commit .env to version control.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────

# Application environment: development | staging | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS — comma-separated list of origins the browser is allowed to call.
# Default covers the Vite dev server on both bare and Docker setups.
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────

# Base URL of the running FastAPI backend, as seen by the BROWSER.
# Keep this as localhost — Docker service names are not resolvable in the browser.
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the WebSocket URL if it differs from VITE_API_BASE_URL.
# Defaults to VITE_API_BASE_URL with http→ws substitution.
# VITE_WS_URL=ws://localhost:8000

# ── Future phases ─────────────────────────────────────────────────────────────
# The variables below are not yet consumed by the FastAPI application.
# They are listed here for reference and will be activated in later phases.

# MongoDB connection string — required when Phase 6 database integration lands.
# Use a MongoDB Atlas URI for cloud, or mongodb://host:port/db for local.
# MONGODB_URI=

# Google Gemini / AI provider key — required for AI agent features.
# GOOGLE_API_KEY=

# Absolute path to the repository the DevFlow CLI agent will analyse.
# Used by the orchestrator CLI runner, not the FastAPI server.
# DEVFLOW_WORKSPACE=

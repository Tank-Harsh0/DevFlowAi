# =============================================================================
# DevFlow AI — Environment Variables
#
# Copy this file to .env and fill in values as needed.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================

# ── Backend ───────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
LOG_LEVEL=INFO

# CORS — comma-separated list of origins allowed to call the API.
# When running with Docker Compose, localhost:5173 is the Vite dev server.
BACKEND_CORS_ORIGINS=http://localhost:5173

# MongoDB connection string.
# Inside Docker Compose, use the service name "mongodb" (not localhost).
# For local development without Docker, use: mongodb://localhost:27017/devflowai
MONGODB_URI=mongodb://mongodb:27017/devflowai

# Google / AI provider key — required when AI agent features are active.
# Leave empty until the AI integration phase.
GOOGLE_API_KEY=

# DevFlow workspace path — absolute path to the repository the agent will analyse.
# Used by the orchestrator agent; leave empty for API-only testing.
DEVFLOW_WORKSPACE=

# ── Frontend ─────────────────────────────────────────────────────────────────

# Base URL of the backend API, as seen by the BROWSER (not the container).
# When running with Docker Compose locally, this is always localhost:8000.
# Do NOT change this to the internal container name — the browser cannot
# resolve Docker service names.
VITE_API_BASE_URL=http://localhost:8000

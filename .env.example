# =============================================================================
# DevFlow AI — Environment Variables
#
# Copy this file to .env and fill in values as needed.
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# NEVER commit .env to version control.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────

# Application environment: development | staging | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS — comma-separated list of origins the browser is allowed to call.
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string — REQUIRED for the backend to start.
# Find yours in: Atlas UI > Cluster > Connect > Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devflow?retryWrites=true&w=majority

# MongoDB database name (default: devflow)
MONGODB_DB_NAME=devflow

# ── Auth (JWT) ────────────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=devflow-change-me-in-production-use-a-real-secret!!

# Access token lifetime in minutes (default: 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend (Vite) ───────────────────────────────────────────────────────────

# Base URL of the running FastAPI backend, as seen by the BROWSER.
# Keep this as localhost — Docker service names are not resolvable in the browser.
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the WebSocket URL if it differs from VITE_API_BASE_URL.
# Defaults to VITE_API_BASE_URL with http→ws substitution.
# VITE_WS_URL=ws://localhost:8000

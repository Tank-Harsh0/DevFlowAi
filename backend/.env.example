# DevFlow AI — Backend environment variables
# Copy this file to .env and fill in values as needed.
# Never commit .env to version control.

# Application
APP_NAME=DevFlow AI
APP_ENV=development
APP_VERSION=0.1.0

# Logging — DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS — comma-separated origins allowed to call this API
# Default: Vite React dev server
BACKEND_CORS_ORIGINS=http://localhost:5173

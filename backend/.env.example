# DevFlow AI — Backend environment variables
# Copy this file to .env and fill in values as needed.
# Never commit .env to version control.

# Application
APP_NAME=DevFlow AI
APP_ENV=development
APP_VERSION=0.1.0

# Logging — DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS — comma-separated origins allowed to call this API
BACKEND_CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas — REQUIRED
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB database name (default: devflow)
MONGODB_DB_NAME=devflow

# JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=devflow-change-me-in-production-use-a-real-secret!!

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

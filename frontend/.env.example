# DevFlow AI — Frontend Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
#
# All VITE_* variables are PUBLICLY VISIBLE in the frontend bundle.
# Do NOT add secrets, API keys, or database credentials here.

# URL of the running FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the WebSocket URL if it differs from the API base URL
# Defaults to VITE_API_BASE_URL with http replaced by ws
# VITE_WS_URL=ws://localhost:8000
